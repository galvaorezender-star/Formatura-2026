                Jun: "✅", Jul: "❌" }
        ];

        // ============================================================
        // 2. TABELA
        // ============================================================
        const tbody = document.getElementById('tableBody');
        const searchInput = document.getElementById('searchInput');

        function contarMesesAberto(p) {
            const meses = [p.Fev, p.Mar, p.Abr, p.Mai, p.Jun, p.Jul];
            return meses.filter(status => status === '❌').length;
        }

        function getAlertaClass(p) {
            const meses = contarMesesAberto(p);
            if (meses >= 4) return 'alerta-4-meses';
            if (meses === 3) return 'alerta-3-meses';
            return '';
        }

        function statusBadge(value) {
            const isPago = value === '✅';
            const cls = isPago ? 'pago' : 'nao-pago';
            return `<span class="status-badge ${cls}">${value}</span>`;
        }

        function renderTable(filter = '') {
            const filtered = participants.filter(p =>
                p.name.toLowerCase().includes(filter.toLowerCase().trim())
            );

            let html = '';
            for (const p of filtered) {
                const alertaClass = getAlertaClass(p);
                html += `<tr class="${alertaClass}">
                    <td>${p.name}</td>
                    <td>${statusBadge(p.Fev)}</td>
                    <td>${statusBadge(p.Mar)}</td>
                    <td class="col-trote">${statusBadge(p.Trote)}</td>
                    <td>${statusBadge(p.Abr)}</td>
                    <td class="col-rifa">${statusBadge(p.Rifa)}</td>
                    <td>${statusBadge(p.Mai)}</td>
                    <td>${statusBadge(p.Jun)}</td>
                    <td>${statusBadge(p.Jul)}</td>
                </tr>`;
            }

            if (filtered.length === 0) {
                html =
                    `<tr><td colspan="9" style="text-align:center;padding:40px 0;color:#94a3b8;">Nenhum participante encontrado</td></tr>`;
            }

            tbody.innerHTML = html;
        }

        searchInput.addEventListener('input', function() {
            renderTable(this.value);
        });

        renderTable();

        // ============================================================
        // 3. TABS
        // ============================================================
        const tabButtons = document.querySelectorAll('.tab-btn');
        const tabContents = {
            pagamentos: document.getElementById('tab-pagamentos'),
            informacoes: document.getElementById('tab-informacoes')
        };

        tabButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                tabButtons.forEach(b => b.classList.remove('active'));
                Object.values(tabContents).forEach(c => c.classList.remove('active'));

                this.classList.add('active');
                const tabId = this.dataset.tab;
                if (tabContents[tabId]) tabContents[tabId].classList.add('active');
            });
        });

        // ============================================================
        // 4. COUNTDOWN GLOBAL - 11/12/2026 18:00
        // ============================================================
        const targetDate = new Date('2026-12-11T18:00:00').getTime();

        function updateGlobalCountdown() {
            const now = Date.now();
            const diff = targetDate - now;

            if (diff <= 0) {
                ['globalDias', 'globalHoras', 'globalMinutos', 'globalSegundos'].forEach(id =>
                    document.getElementById(id).textContent = '00'
                );
                return;
            }

            const d = Math.floor(diff / 86400000);
            const h = Math.floor((diff % 86400000) / 3600000);
            const m = Math.floor((diff % 3600000) / 60000);
            const s = Math.floor((diff % 60000) / 1000);

            document.getElementById('globalDias').textContent = String(d).padStart(2, '0');
            document.getElementById('globalHoras').textContent = String(h).padStart(2, '0');
            document.getElementById('globalMinutos').textContent = String(m).padStart(2, '0');
            document.getElementById('globalSegundos').textContent = String(s).padStart(2, '0');
        }

        updateGlobalCountdown();
        setInterval(updateGlobalCountdown, 1000);
    </script>
